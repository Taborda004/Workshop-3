// Workshop-3: DAX Formulas & Calculated Columns for Power BI Dashboard
// Course: ETL (G01) - Workshop 3: Streaming ETL with Apache Kafka & Machine Learning
// ============================================================================

// ----------------------------------------------------------------------------
// 1. Core Measures for fact_predictions
// ----------------------------------------------------------------------------

Total_Predictions = COUNTROWS(fact_predictions)

Avg_Actual_Score = AVERAGE(fact_predictions[actual_score])

Avg_Predicted_Score = AVERAGE(fact_predictions[predicted_score])

// KPI 1: Mean Absolute Error (MAE)
MAE = AVERAGEX(fact_predictions, ABS(fact_predictions[actual_score] - fact_predictions[predicted_score]))

// KPI 1: Root Mean Squared Error (RMSE)
RMSE = SQRT(AVERAGEX(fact_predictions, (fact_predictions[actual_score] - fact_predictions[predicted_score])^2))

// Mean Prediction Bias (Over/Under Estimation)
Prediction_Bias = AVERAGE(fact_predictions[prediction_error])

// Relative Error Percentage
Relative_Error_Pct = DIVIDE([MAE], [Avg_Actual_Score], 0) * 100


// ----------------------------------------------------------------------------
// 2. Calculated Column for KPI 3 (Precision Tier Classification)
// Add this column to table 'fact_predictions':
// ----------------------------------------------------------------------------

Precision_Bracket = 
SWITCH(
    TRUE(),
    ABS(fact_predictions[prediction_error]) <= 0.25, "1. High Precision (|err| <= 0.25)",
    ABS(fact_predictions[prediction_error]) <= 0.50, "2. Acceptable (0.25 < |err| <= 0.50)",
    "3. Divergent (|err| > 0.50)"
)


