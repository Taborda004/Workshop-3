        "measures": [
          {
            "name": "Total Predictions",
            "expression": "COUNTROWS(fact_predictions)",
            "formatString": "#,0",
            "lineageTag": "f77e19a4-45e0-456b-94c4-b4dccf15f3ae",
            "dataType": "int64",
            "modifiedTime": "2026-11-14T03:20:14.893333",
            "structureModifiedTime": "2026-11-14T03:20:10.61"
          },
          {
            "name": "MAE",
            "expression": "SUMX(fact_predictions, ABS(fact_predictions[prediction_error])) / COUNTROWS(fact_predictions)",
            "formatString": "0.0000",
            "lineageTag": "f5ba96af-e9c3-4d13-bcd9-4c1944de1bbb",
            "dataType": "double",
            "modifiedTime": "2026-11-14T03:20:14.893333",
            "structureModifiedTime": "2026-11-14T03:20:10.61"
          },
          {
            "name": "RMSE",
            "expression": "SQRT(SUMX(fact_predictions, fact_predictions[prediction_error] * fact_predictions[prediction_error]) / COUNTROWS(fact_predictions))",
            "formatString": "0.0000",
            "lineageTag": "bf24eb49-c27e-4ed4-9282-7860974cb617",
            "dataType": "double",
            "modifiedTime": "2026-11-14T03:20:14.893333",
            "structureModifiedTime": "2026-11-14T03:20:10.61"
          },
          {
            "name": "Avg Actual Score",
            "expression": "AVERAGE(fact_predictions[actual_score])",
            "formatString": "0.000",
            "lineageTag": "6204d704-cfa7-4919-ac4b-0973004ae57a",
            "dataType": "double",
            "modifiedTime": "2026-11-14T03:20:14.893333",
            "structureModifiedTime": "2026-11-14T03:20:10.61"
          },
          {
            "name": "Avg Predicted Score",
            "expression": "AVERAGE(fact_predictions[predicted_score])",
            "formatString": "0.000",
            "lineageTag": "d15c1f7b-09ab-4788-88fd-37e18dba1634",
            "dataType": "double",
            "modifiedTime": "2026-11-14T03:20:14.893333",
            "structureModifiedTime": "2026-11-14T03:20:10.61"
          },
          {
            "name": "Prediction Bias",
            "expression": "[Avg Predicted Score] - [Avg Actual Score]",
            "formatString": "+0.0000;-0.0000;0.0000",
            "lineageTag": "128cf032-5326-4a2a-8ffa-d9ce7066eff6",
            "dataType": "double",
            "modifiedTime": "2026-11-14T03:20:14.893333",
            "structureModifiedTime": "2026-11-14T03:20:10.61"
          }
        ]
