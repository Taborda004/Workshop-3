table fact_predictions
	lineageTag: b38e92d7-b89e-4c74-a63e-7f61c6bfe76b

	measure 'Total Predictions' = COUNTROWS(fact_predictions)
		formatString: #,0
		lineageTag: e83cf8d1-58e1-4566-a67b-f111818d6e32

	measure MAE = SUMX(fact_predictions, ABS(fact_predictions[prediction_error])) / COUNTROWS(fact_predictions)
		formatString: 0.0000
		lineageTag: f84cf8d1-58e1-4566-a67b-f111818d6e33

	measure RMSE = SQRT(SUMX(fact_predictions, fact_predictions[prediction_error] * fact_predictions[prediction_error]) / COUNTROWS(fact_predictions))
		formatString: 0.0000
		lineageTag: a14cf8d1-58e1-4566-a67b-f111818d6e34

	measure 'Avg Actual Score' = AVERAGE(fact_predictions[actual_score])
		formatString: 0.000
		lineageTag: b24cf8d1-58e1-4566-a67b-f111818d6e35

	measure 'Avg Predicted Score' = AVERAGE(fact_predictions[predicted_score])
		formatString: 0.000
		lineageTag: c34cf8d1-58e1-4566-a67b-f111818d6e36

	measure 'Prediction Bias' = [Avg Predicted Score] - [Avg Actual Score]
		formatString: +0.0000;-0.0000;0.0000
		lineageTag: d44cf8d1-58e1-4566-a67b-f111818d6e37

